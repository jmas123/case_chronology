# Anthropic API key for the extraction agent.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional. Override the default model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Backend server config.
API_HOST=0.0.0.0
API_PORT=8001

# SQLite database file path, relative to api/.
DATABASE_URL=sqlite:///./case_chronology.db

# Upload directory, relative to api/.
UPLOAD_DIR=./uploads

# Frontend config. URL of the FastAPI server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
